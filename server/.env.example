# DayByDay Environment Configuration Template

# Server Port
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/daybyday)
MONGO_URI=mongodb://127.0.0.1:27017/daybyday

# CORS Allowed Origin
CORS_ORIGIN=*

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
